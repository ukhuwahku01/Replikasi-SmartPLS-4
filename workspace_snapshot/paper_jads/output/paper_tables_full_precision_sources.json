      ],
      "rows": [
        [
          "AIR / AIR1–AIR4",
          "Perceived AI Reliability",
          "Expected consistency and appropriateness of detections and notifications, and stable functioning during digital play."
        ],
        [
          "EXP / EXP1–EXP4",
          "Explainability",
          "Reported understanding of described reasons, warning information, prediction confidence and possible errors, and interpretation of alerts."
        ],
        [
          "PP / PP1–PP4",
          "Perceived Privacy Protection",
          "Perceived adequacy of proposed controls for camera/microphone permission, storage, deletion, and child-data protection."
        ],
        [
          "TR / TR1–TR4",
          "Trust",
          "Confidence that the proposed system would serve the child’s interests and responsibly provide initial emotion-related information."
        ],
        [
          "AD / AD1–AD4",
          "Adoption Intention",
          "Conditional intentions to try and use KidSense and its warning features, including prospective continuation if experience meets expectations."
        ]
      ],
      "note": "Four reflective indicators per construct. Definitions describe the researcher-specified instrument; they do not establish objective AI capability, audited safeguards, or actual behavior.",
